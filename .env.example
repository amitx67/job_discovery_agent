# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# --- Required ---
PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
TAVILY_API_KEY=your_tavily_api_key
GOOGLE_API_KEY=your_google_api_key

# --- Optional: model ---
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional: scheduler (runs inside the API server) ---
ENABLE_SCHEDULER=false
SCHEDULER_CRON=0 */6 * * *

# --- Optional: pipeline tuning ---
SEARCH_MAX_RESULTS=5
MAX_QUERIES=40
SKIP_KNOWN_JOBS=true
EXTRACT_BATCH_SIZE=20
LLM_BATCH_SIZE=5
LLM_MAX_PAGE_CONTENT=7000

# --- Optional: DNS servers for MongoDB Atlas SRV resolution ---
DNS_SERVERS=8.8.8.8,1.1.1.1
